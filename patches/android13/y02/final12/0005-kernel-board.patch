diff --git a/kernel-5.10/kernel/configs/x7pro.config b/kernel-5.10/kernel/configs/x7pro.config
new file mode 100644
index 0000000000000000000000000000000000000000..8123b10ae4c1d8121a0ccb3e0c2c9fa885184f9a
--- /dev/null
+++ b/kernel-5.10/kernel/configs/x7pro.config
@@ -0,0 +1,104 @@
+# X7 Pro stock modules were built for 5.10.160 without symbol versions
+# or full preemption. Keep the Android kernel's module ABI compatible.
+CONFIG_LOCALVERSION=""
+# CONFIG_LOCALVERSION_AUTO is not set
+# CONFIG_MODVERSIONS is not set
+# CONFIG_PREEMPT is not set
+CONFIG_PREEMPT_VOLUNTARY=y
+CONFIG_ARM64_ERRATUM_2051678=y
+# The dictionary-pen defconfig omits SELinux from the ordered LSM list even
+# when CONFIG_SECURITY_SELINUX is merged by android-base.config. Android init
+# treats an unavailable selinuxfs as fatal during first-stage init.
+CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,bpf"
+# /data uses F2FS with AES-XTS file encryption and dm-default-key metadata
+# encryption. Without these targets vold fails DM_TABLE_LOAD during init_user0.
+CONFIG_BLK_INLINE_ENCRYPTION=y
+CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
+CONFIG_DM_DEFAULT_KEY=y
+CONFIG_FS_ENCRYPTION=y
+CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
+CONFIG_F2FS_FS=y
+CONFIG_F2FS_FS_XATTR=y
+CONFIG_F2FS_FS_POSIX_ACL=y
+CONFIG_F2FS_FS_SECURITY=y
+CONFIG_UNICODE=y
+CONFIG_CRYPTO_CTS=y
+CONFIG_CRYPTO_XTS=y
+CONFIG_CRYPTO_SHA512=y
+# Android's bpfloader mounts bpffs during boot, while lmkd relies on cpuset and
+# memory cgroups. Missing these makes the critical exec service hang and init
+# reboot to the bootloader.
+CONFIG_BPF_SYSCALL=y
+CONFIG_BPF_JIT=y
+# Required by Android 13 FCM level 7; legacy binder devices remain enabled.
+CONFIG_ANDROID_BINDERFS=y
+CONFIG_SENSOR_DEVICE=y
+CONFIG_GSENSOR_DEVICE=y
+CONFIG_GS_DA267_X7PRO=y
+CONFIG_ZSMALLOC=y
+CONFIG_ZRAM=y
+CONFIG_ZRAM_WRITEBACK=y
+CONFIG_CRYPTO_LZ4=y
+CONFIG_LZ4_COMPRESS=y
+CONFIG_LZ4_DECOMPRESS=y
+CONFIG_QFMT_V2=y
+CONFIG_QUOTA_NETLINK_INTERFACE=y
+CONFIG_FS_VERITY=y
+CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
+CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
+CONFIG_CGROUP_BPF=y
+CONFIG_NET_CLS_BPF=y
+CONFIG_NET_ACT_BPF=y
+CONFIG_NETFILTER_XT_MATCH_BPF=y
+CONFIG_NETFILTER_XT_MATCH_OWNER=y
+CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
+CONFIG_CPUSETS=y
+CONFIG_MEMCG=y
+CONFIG_BLK_CGROUP=y
+CONFIG_PSI=y
+CONFIG_UCLAMP_TASK=y
+CONFIG_AIO=y
+CONFIG_IO_URING=y
+CONFIG_LSM_MMAP_MIN_ADDR=4096
+CONFIG_SND_SEQUENCER=y
+# Keep the stock ALSA core ordering; changing proc/loopback options exposes an
+# RK817 control-registration memory bug during early boot on this 5.10 tree.
+# CONFIG_SND_PROC_FS is not set
+CONFIG_SND_ALOOP=y
+# The stock v1.2 driver only supports PID 2049; X7 Pro uses AW88399 PID 2183.
+# CONFIG_SND_SOC_AW883XX is not set
+CONFIG_SND_SOC_AW883XX_V16=m
+# RK817 microphone/PDM enablement remains separate from speaker bring-up.
+CONFIG_SND_SOC_ROCKCHIP_PDM=y
+CONFIG_ROCKCHIP_CLK_OUT=y
+CONFIG_SW_SYNC=y
+CONFIG_SW_SYNC_DEBUG=y
+# The stock Sitronix touchscreen module combines I2C and SPI frontends and
+# therefore imports the SPI core API even on this I2C-wired board.
+CONFIG_SPI=y
+CONFIG_SPI_ROCKCHIP=y
+CONFIG_TOUCHSCREEN_X7_SITRONIX=y
+# Mali Gralloc allocates scanout and app buffers from system-uncached.  The
+# dictionary-pen defconfig only creates /dev/ion without a usable system heap.
+CONFIG_DMABUF_HEAPS=y
+CONFIG_DMABUF_HEAPS_DEFERRED_FREE=y
+CONFIG_DMABUF_HEAPS_PAGE_POOL=y
+CONFIG_DMABUF_HEAPS_SYSTEM=y
+CONFIG_DMABUF_HEAPS_CMA=y
+# Some Rockchip userspace still requests the legacy heap by this exact name.
+CONFIG_ION_SYSTEM_HEAP=y
+# Camera still capture uses the RK3562 RKVENC block for JPEG encoding.
+CONFIG_ROCKCHIP_MPP_RKVENC2=y
+# CONFIG_MODULE_SIG_FORCE is not set
+# CONFIG_TRIM_UNUSED_KSYMS is not set
+# X7 Pro scan camera; GC8034/DW9714/AW883XX are already =y in rockchip_defconfig.
+CONFIG_VIDEO_SC035GS=y
+CONFIG_X7PRO_TP_REPORT_COMPAT=y
+# U-Boot arms the hardware watchdog (snps,dw-wdt) on every normal boot;
+# the kernel must register the driver to feed it.
+CONFIG_DW_WATCHDOG=y
+CONFIG_USB_DWC3=y
+CONFIG_USB_DWC3_OF_SIMPLE=y
+# Source driver from Awinic's official Rockchip v0.1.0 package. Stock X7 Pro
+# modules, including DWC3, are structurally incompatible with this kernel.
+CONFIG_TYPEC_AW35616=y
