diff --git a/kernel-5.10/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c b/kernel-5.10/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
index 5256fc6f23a26340d0a66c92ca9c25f3b1885ee5..37b88d42c9e1f124f9b7006f40f815b9be82053c 100644
--- a/kernel-5.10/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
+++ b/kernel-5.10/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
@@ -2998,6 +2998,15 @@ static void vop2_debug_irq_enable(struct drm_crtc *crtc)
 	uint32_t irqs = POST_BUF_EMPTY_INTR;
 
 	VOP_INTR_SET_TYPE(vop2, intr, clear, irqs, 1);
+	/*
+	 * RK3562 can keep POST_BUF_EMPTY asserted continuously while a narrow
+	 * single-lane DSI mode is being brought up.  This interrupt is diagnostic
+	 * only, but the resulting hard-IRQ storm starves threaded peripherals such
+	 * as DWC3.  Leave it masked on RK3562 until the panel timing is corrected.
+	 */
+	if (vop2->version == VOP_VERSION_RK3562)
+		return;
+
 	VOP_INTR_SET_TYPE(vop2, intr, enable, irqs, 1);
 }
 
