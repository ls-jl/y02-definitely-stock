+bool writeBes2600Command(const char* command) {
+    const std::string payload = std::string("ifname:NONE cmd:") + command;
+    int fd = TEMP_FAILURE_RETRY(open(kBes2600ControlDevice, O_WRONLY | O_CLOEXEC));
+    if (fd < 0) {
+        PLOG(ERROR) << "Failed to open BES2600 control device";
+        return false;
+    }
+
+    const ssize_t written = TEMP_FAILURE_RETRY(write(fd, payload.data(), payload.size()));
+    const int saved_errno = errno;
+    close(fd);
+    if (written != static_cast<ssize_t>(payload.size())) {
+        errno = saved_errno;
+        PLOG(ERROR) << "Failed to send BES2600 command " << command;
+        return false;
+    }
+    return true;
+}
+
+bool isBes2600BluetoothOpened() {
+    int fd = TEMP_FAILURE_RETRY(open(kBes2600ControlDevice, O_RDONLY | O_CLOEXEC));
+    if (fd < 0) return false;
+
+    std::array<char, 65> state{};
+    const ssize_t length = TEMP_FAILURE_RETRY(read(fd, state.data(), state.size() - 1));
+    close(fd);
+    return length > 0 && strstr(state.data(), "bt_opened:1") != nullptr;
+}
+
+bool waitForBes2600Interface() {
+    for (int retry = 0; retry < 40; retry++) {
+        if (access(kBes2600WifiInterface, F_OK) == 0) return true;
+        std::this_thread::sleep_for(std::chrono::milliseconds(250));
+    }
+    return false;
+}
+
+// BES2600 can occasionally stop responding when Wi-Fi is re-enabled after a
+// long Bluetooth-only idle period. The driver leaves a registered wlan0, but
+// bringing it up fails with ENODEV after its firmware startup timeout. A full
+// combo-chip power cycle is the only recovery which works without rebooting
+// the device. Preserve the user's Bluetooth state across that recovery.
+bool recoverBes2600AfterStartFailure() {
+    if (access(kBes2600ControlDevice, F_OK) != 0) return false;
+
+    const bool restore_bluetooth = isBes2600BluetoothOpened();
+    LOG(WARNING) << "BES2600 interface start failed; power-cycling combo chip";
+
+    bool success = true;
+    if (restore_bluetooth) success &= writeBes2600Command("BT_OFF");
+    success &= writeBes2600Command("WIFI_OFF");
+    std::this_thread::sleep_for(std::chrono::milliseconds(1000));
+    success &= writeBes2600Command("WIFI_ON");
+    success &= waitForBes2600Interface();
+    if (restore_bluetooth) {
+        success &= writeBes2600Command("BT_ON");
+        // The HCI process retains state from before the combo firmware reset.
+        // Ask init to restart it immediately so Bluetooth coexistence and Wi-Fi
+        // association recover together. Toggle through zero so every recovery
+        // produces a property edge even if the previous value remains one.
+        property_set(kBes2600BluetoothHalResetProp, "0");
+        property_set(kBes2600BluetoothHalResetProp, "1");
+    }
+
+    if (!success) LOG(ERROR) << "BES2600 combo-chip recovery failed";
+    return success;
+}
 
