+MANUFACTURER: Youdao
+MAGIC: 0x5041524B
+ATAG: 0x00200800
+MACHINE: rk3562_x7pro_go
+CHECK_MASK: 0x80
+PWR_HLD: 0,0,A,0,1
+TYPE: GPT
+# Preserve uboot/trust/misc. SPL gzip uses an overlapping 2 MiB scratch area,
