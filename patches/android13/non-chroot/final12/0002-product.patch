+include device/rockchip/rk3562/BoardConfig.mk
+BUILD_WITH_GO_OPT := true
+PRODUCT_KERNEL_CONFIG += x7pro.config
+PRODUCT_UBOOT_CONFIG := rk3562
+PRODUCT_KERNEL_DTS := rk3562-y02-v10
+PRODUCT_PARAMETER_TEMPLATE := device/rockchip/rk3562/rk3562_x7pro_go/parameter_ab.txt
+BOARD_USE_RAW_PARAMETER_TEMPLATE := true
+CAMERA_SUPPORT_AUTOFOCUS := true
+BOARD_CAMERA_SUPPORT_EXT := true
+
+# Produce the stock U-Boot/SPL external-data FIT directly as boot.img. The
+# wrapper gzip-compresses the kernel so the complete image fits boot_a/boot_b.
+BOARD_CUSTOM_MKBOOTIMG := device/rockchip/rk3562/rk3562_x7pro_go/mkbootimg_x7pro.py
+
+# X7 Pro wireless connectivity is the BES2600 SDIO combo chip.
+BOARD_WLAN_DEVICE := bes2600
+BOARD_HAVE_BLUETOOTH_BES := true
+BOARD_BLUETOOTH_BES_UART_PORT := /dev/ttyS1
+
+BOARD_SEPOLICY_DIRS += device/rockchip/rk3562/rk3562_x7pro_go/sepolicy/vendor
+
+# The stock X7 Pro partition table and boot arguments use A/B slots.
+BOARD_USES_AB_IMAGE := true
+BOARD_ROCKCHIP_VIRTUAL_AB_ENABLE := false
+
+ifeq ($(strip $(BOARD_USES_AB_IMAGE)), true)
+  include device/rockchip/common/BoardConfig_AB.mk
+  # Keep the generic parameter generator's build-time DTBO size non-zero even
+  # though X7 Pro embeds its DTB in FIT and excludes DTBO from the physical GPT.
+  BOARD_DTBOIMG_PARTITION_SIZE := 4194304
+  # BoardConfig_AB.mk points TARGET_RECOVERY_FSTAB at recovery.fstab_AB,
+  # whose slotselect/logical flags crash the Rockchip recovery binary;
+  # use the classic simple fstab instead.
+  TARGET_RECOVERY_FSTAB := device/rockchip/rk3562/rk3562_x7pro_go/recovery.fstab
+endif
diff --git a/device/rockchip/rk3562/rk3562_x7pro_go/README.md b/device/rockchip/rk3562/rk3562_x7pro_go/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..8dd066c9f13f422a418fd54d0300a03d118e08fb
--- /dev/null
+++ b/device/rockchip/rk3562/rk3562_x7pro_go/README.md
@@ -0,0 +1,36 @@
+# RK3562 X7 Pro Android Go product
+
+This product is derived from `rk3562_tgo` for the Youdao X7 Pro hardware.
+
+- Android 13 / API 33
+- Android Go low-RAM configuration
+- Traditional A/B slots (virtual A/B disabled)
+- Kernel release target: 5.10.160
+- Kernel DTS: `rk3562-y02-v10`
+- Display: 280 x 936 MIPI-DSI
+
+The DTS is a lossless decompile of the DTB read from the live X7 Pro. Building
+it through the kernel Makefile reproduces the stock DTB exactly:
+
+`f8da8a05ba52fe98e3ef39adf6d456471a5f832e1dc07dd4fd66662b97eca8a4`
+
+The local Android SDK contains a 5.10.157 source snapshot but no local
+5.10.158--5.10.160 stable patches. The current 5.10.160 change therefore
+aligns the kernel release and module ABI only. Do not treat it as a source-level
+backport of all three stable releases.
+
+The final kernel config order is:
+
+```text
+rockchip_defconfig android-13-go.config rk356x.config x7pro.config
+```
+
+`x7pro.config` disables module symbol versions and full preemption to match the
+stock X7 Pro modules' `5.10.160 SMP mod_unload aarch64` vermagic. It also
+enables the ALSA sequencer symbols required by the stock MIDI modules.
+
+The X7 Pro build path passes an empty `LOCALVERSION`, preventing a dirty local
+tree from adding `+` to the module ABI. A symbol audit of all 46 stock modules
+leaves three device-specific interfaces to implement before packaging:
+`_trace_android_vh_record_pcpu_rwsem_starttime`, `report_tp_unvalid`, and
+`mmc_host_rescan`.
