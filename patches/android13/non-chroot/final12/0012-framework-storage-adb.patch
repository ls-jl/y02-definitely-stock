diff --git a/system/core/fs_mgr/fs_mgr_slotselect.cpp b/system/core/fs_mgr/fs_mgr_slotselect.cpp
index 09c1b7e20e97977137462ef916fa4b547cff917a..c4fc341baa93e8bf7a49834456c68a81498e8315 100644
--- a/system/core/fs_mgr/fs_mgr_slotselect.cpp
+++ b/system/core/fs_mgr/fs_mgr_slotselect.cpp
@@ -18,6 +18,8 @@
 
 #include <string>
 
+#include <android-base/file.h>
+
 #include "fs_mgr.h"
 #include "fs_mgr_priv.h"
 
@@ -48,7 +50,25 @@ std::string fs_mgr_get_other_slot_suffix() {
 std::string fs_mgr_get_slot_suffix() {
     std::string ab_suffix;
 
-    fs_mgr_get_boot_config("slot_suffix", &ab_suffix);
+    if (fs_mgr_get_boot_config("slot_suffix", &ab_suffix) &&
+        (ab_suffix == "_a" || ab_suffix == "_b")) {
+        return ab_suffix;
+    }
+
+    // The stock X7 Pro boot_fit path publishes the selected AVB slot with
+    // Rockchip's legacy spelling instead of androidboot.slot_suffix. Keep the
+    // fallback local to fs_mgr so standard Android bootloaders remain first.
+    std::string cmdline;
+    if (android::base::ReadFileToString("/proc/cmdline", &cmdline)) {
+        for (const auto& [key, value] : fs_mgr_parse_cmdline(cmdline)) {
+            if (key == "android_slotsufix" && (value == "_a" || value == "_b")) {
+                LWARNING << "using legacy Rockchip slot suffix " << value;
+                return value;
+            }
+        }
+    }
+
+    ab_suffix.clear();
     return ab_suffix;
 }
 
