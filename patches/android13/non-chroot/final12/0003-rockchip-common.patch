diff --git a/device/rockchip/common/rootdir/init.insmod.cfg b/device/rockchip/common/rootdir/init.insmod.cfg
index 06e68e9b6735a0bca30aa341c8fc99ba9aef9d95..6445a8bd33940870cfa04790e228fa084cda2276 100644
--- a/device/rockchip/common/rootdir/init.insmod.cfg
+++ b/device/rockchip/common/rootdir/init.insmod.cfg
@@ -9,6 +9,12 @@ insmod /vendor/lib/modules/pvrsrvkm.ko
 insmod /vendor/lib/modules/rknpu.ko
 insmod /vendor/lib/modules/rknpu-clang.ko
 insmod /vendor/lib/modules/r8168.ko
+insmod /vendor/lib/modules/snd-soc-aw883xx-v16.ko
+# X7 Pro stock vendor modules are intentionally not auto-loaded. Runtime testing
+# proved that their private 5.10.160 structural ABI is incompatible with this
+# kernel even though vermagic and exported-symbol checks pass: fake_keys.ko
+# faults in load_module()/rb_erase. Port or rebuild each driver from source
+# before re-enabling it; do not trade a booting Android system for binary reuse.
 #insmod /system/lib/modules/rtk_btusb.ko
 #insmod /rk30xxnand_ko.ko
 #insmod /drmboot.ko
