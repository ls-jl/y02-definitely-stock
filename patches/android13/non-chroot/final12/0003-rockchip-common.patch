diff --git a/device/rockchip/common/modules/recovery.mk b/device/rockchip/common/modules/recovery.mk
index def34198e08b08ee9c258323c393f6482fb9e040..002564fb33eadc51e6f47257c7d9599568d358bc 100644
--- a/device/rockchip/common/modules/recovery.mk
+++ b/device/rockchip/common/modules/recovery.mk
@@ -95,6 +95,21 @@ PRODUCT_PACKAGES += \
   bootctrl.rk30board \
   bootctrl.rk30board.recovery
 
+# X7 Pro embeds DTB in its stock-format FIT boot image, keeps the stock
+# bootloader/trust slots unchanged, and has no standalone DTBO/VBMeta entries.
+ifeq ($(strip $(TARGET_PRODUCT)),rk3562_x7pro_go)
+AB_OTA_PARTITIONS := \
+    boot \
+    system \
+    system_dlkm \
+    system_ext \
+    vendor \
+    vendor_dlkm \
+    odm \
+    odm_dlkm \
+    product
+endif
+
 PRODUCT_PACKAGES_DEBUG += \
     bootctl
 
