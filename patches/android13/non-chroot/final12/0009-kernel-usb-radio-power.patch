+static struct device_node *
+rk817_bat_select_profile(struct rk817_battery_device *battery,
+			 struct device_node *parent)
+{
+	struct device_node *profile, *best = NULL;
+	struct iio_channel *channel;
+	char name[24];
+	u32 type_res_diff = 30, type_res;
+	int best_delta = 0x7fffffff;
+	int delta, index, raw, ret;
+
+	if (!of_get_child_count(parent))
+		return NULL;
+
+	of_property_read_u32(parent, "type_res_diff", &type_res_diff);
+	channel = devm_iio_channel_get(battery->dev, NULL);
+	if (IS_ERR(channel)) {
+		dev_warn(battery->dev, "battery type ADC unavailable: %ld\n",
+			 PTR_ERR(channel));
+		return of_get_child_by_name(parent, "battery_type,0");
+	}
+
+	ret = iio_read_channel_raw(channel, &raw);
+	if (ret < 0) {
+		dev_warn(battery->dev, "battery type ADC read failed: %d\n", ret);
+		return of_get_child_by_name(parent, "battery_type,0");
+	}
+
+	for (index = 0; index < 16; index++) {
+		snprintf(name, sizeof(name), "battery_type,%d", index);
+		profile = of_get_child_by_name(parent, name);
+		if (!profile)
+			break;
+		if (of_property_read_u32(profile, "bat_type_res", &type_res)) {
+			of_node_put(profile);
+			continue;
+		}
+
+		delta = abs(raw - (int)type_res);
+		if (delta < best_delta) {
+			of_node_put(best);
+			best = profile;
+			best_delta = delta;
+		} else {
+			of_node_put(profile);
+		}
+	}
+
+	if (!best)
+		best = of_get_child_by_name(parent, "battery_type,0");
+	if (best_delta > type_res_diff)
+		dev_warn(battery->dev,
+			 "battery type ADC %d outside tolerance %u (delta %d)\n",
+			 raw, type_res_diff, best_delta);
+	else
+		dev_info(battery->dev, "battery profile %pOF selected (ADC %d)\n",
+			 best, raw);
+
+	return best;
+}
