+
+typedef union {
+	u8 byte;
+	struct {
+		u8 reserved:1;
+		u8 tog_save_md:2;
+		u8 reserved1:5;
+	};
+} reg_ctr2;
+
+typedef struct {
+	reg_dev_id dev_id;
