 EXPORT_SYMBOL(mmc_add_host);
 
+/**
+ *	mmc_host_rescan - trigger a software rescan flow
+ *	@host: mmc host, or NULL for the primary SDIO host
+ *	@val: new card detect state
+ *	@is_cap_sdio_irq: 1 to set MMC_CAP_SDIO_IRQ, 0 to clear it
+ *
+ *	Rockchip vendor interface used by rfkill-rk.ko on the X7 Pro to
+ *	re-enumerate the SDIO Wi-Fi chip after a power cycle. Rescans the
+ *	slot attached to @host; if @host is NULL, rescans the primary
+ *	SDIO host saved by mmc_add_host().
+ */
+int mmc_host_rescan(struct mmc_host *host, int val, int is_cap_sdio_irq)
+{
+	if (!host) {
+		host = READ_ONCE(primary_sdio_host);
+		if (!host) {
+			pr_err("sdio: no primary SDIO host registered\n");
+			return -ENOMEDIUM;
+		}
+	}
+
+	if (is_cap_sdio_irq == 1)
+		host->caps |= MMC_CAP_SDIO_IRQ;
+	else if (is_cap_sdio_irq == 0)
+		host->caps &= ~MMC_CAP_SDIO_IRQ;
+	else
+		return -EINVAL;
+
+	if (!(host->caps & MMC_CAP_NONREMOVABLE) &&
+	    host->ops->set_sdio_status)
+		return host->ops->set_sdio_status(host, val);
+
+	if (!(host->caps & MMC_CAP_NONREMOVABLE))
+		mmc_detect_change(host, 0);
+
+	return 0;
+}
+EXPORT_SYMBOL(mmc_host_rescan);
