+	/*
+	 * Remember the primary SDIO host (SDIO-only slot, e.g. the Wi-Fi
+	 * chip) so that mmc_host_rescan() can find it when callers pass
+	 * NULL, like the Rockchip rfkill driver does.
+	 */
+	if (!READ_ONCE(primary_sdio_host) &&
+	    !(host->caps2 & MMC_CAP2_NO_SDIO) &&
+	    (host->caps2 & MMC_CAP2_NO_SD) &&
