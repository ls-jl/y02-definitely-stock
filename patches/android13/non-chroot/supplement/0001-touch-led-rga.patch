+			pr_err("%s(%d), invalid physical buffer pa=0x%llx size=%lu\n",
+			       __func__, __LINE__, buffer->phys_addr, buffer->size);
 			return -EINVAL;
 		}
-
-		dma_sync_sg_for_device(scheduler->dev, sgt->sgl, sgt->orig_nents, dir);
+		dma_sync_single_for_device(scheduler->dev,
+					   phys_to_dma(scheduler->dev,
+						       buffer->phys_addr),
+					   buffer->size, dir);
+	} else {
+		pr_err("%s(%d), failed to get sgt, core = 0x%x\n",
+		       __func__, __LINE__, job->core);
+		return -EINVAL;
 	}
 
 	return 0;
@@ -1339,17 +1354,23 @@ static int rga_mm_sync_dma_sg_for_cpu(struct rga_internal_buffer *buffer,
 		return -EFAULT;
 	}
 
-	if (buffer->mm_flag & RGA_MEM_PHYSICAL_CONTIGUOUS) {
-		dma_sync_single_for_cpu(scheduler->dev, buffer->phys_addr, buffer->size, dir);
-	} else {
-		sgt = rga_mm_lookup_sgt(buffer);
-		if (sgt == NULL) {
-			pr_err("%s(%d), failed to get sgt, core = 0x%x\n",
-			       __func__, __LINE__, job->core);
+	sgt = rga_mm_lookup_sgt(buffer);
+	if (sgt != NULL) {
+		dma_sync_sg_for_cpu(scheduler->dev, sgt->sgl, sgt->orig_nents, dir);
+	} else if (buffer->mm_flag & RGA_MEM_PHYSICAL_CONTIGUOUS) {
+		if (buffer->phys_addr == 0 || buffer->size == 0) {
+			pr_err("%s(%d), invalid physical buffer pa=0x%llx size=%lu\n",
