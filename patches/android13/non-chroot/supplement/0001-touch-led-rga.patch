+	/*
+	 * phys_addr is a CPU physical address, not necessarily a DMA address.
+	 * RK3562's RGA device has a non-zero dma_pfn_offset; passing phys_addr
+	 * directly to dma_sync_single_*() subtracts that offset a second time and
+	 * can make arch_sync_dma_for_device clean physical address zero. Prefer
+	 * the already DMA-mapped scatterlist even when it has one contiguous entry.
+	 */
+	sgt = rga_mm_lookup_sgt(buffer);
+	if (sgt != NULL) {
+		dma_sync_sg_for_device(scheduler->dev, sgt->sgl, sgt->orig_nents, dir);
+	} else if (buffer->mm_flag & RGA_MEM_PHYSICAL_CONTIGUOUS) {
